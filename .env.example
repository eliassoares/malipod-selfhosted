APP_NAME=Malipod
ENVIRONMENT=local
LOG_LEVEL=INFO
# Device API reuses the existing auth, session, and database settings below.
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
DATABASE_URL=postgresql+asyncpg://malipod:malipod@db:5432/malipod
TEST_DATABASE_URL=sqlite+aiosqlite:///./test.db
SECRET_KEY=change-me-with-at-least-32-characters
SESSION_COOKIE_NAME=sessionid
SESSION_TTL_SECONDS=1209600
DEFAULT_LOCALE=en
SUPPORTED_LOCALES=en,es,pt-BR
ARCHIVE_DIR=./archive
ARCHIVE_WORKERS=2
ARCHIVE_SYNC_INTERVAL_MINUTES=60
